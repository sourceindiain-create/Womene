{
  "entities": {
    "booking": {
      "title": "ServiceBooking",
      "description": "User requests for elder care, home help, food, travel companion, or agricultural tech assistance.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serviceType": { "type": "string" },
        "clientName": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "assigned", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["serviceType", "clientName", "phone", "location", "status", "createdAt"]
    },
    "emergencyAlert": {
      "title": "EmergencySosAlert",
      "description": "High-priority emergency alerts triggered by users in distress.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userName": { "type": "string" },
        "phone": { "type": "string" },
        "emergencyType": { "type": "string" },
        "locationLat": { "type": "number" },
        "locationLng": { "type": "number" },
        "addressText": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "dispatched", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userName", "phone", "emergencyType", "status", "createdAt"]
    },
    "aiConsultation": {
      "title": "AiDoctorConsultation",
      "description": "Logged triage and consultations from the 6 AI Doctor categories.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "doctorCategory": { "type": "string", "enum": ["human", "animal", "bird", "plant", "crop", "soil"] },
        "symptoms": { "type": "string" },
        "language": { "type": "string" },
        "summary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["doctorCategory", "symptoms", "language", "createdAt"]
    },
    "fcmToken": {
      "title": "FcmDeviceToken",
      "description": "FCM device registration tokens for push notifications and emergency dispatch.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "token": { "type": "string", "maxLength": 500 },
        "platform": { "type": "string", "enum": ["web", "android", "ios"] },
        "userAgent": { "type": "string", "maxLength": 500 },
        "topics": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActive": { "type": "string", "format": "date-time" }
      },
      "required": ["token", "platform", "status", "createdAt", "lastActive"]
    },
    "fcmBroadcast": {
      "title": "FcmBroadcastNotification",
      "description": "Real-time push alerts, emergency broadcasts, and community updates dispatched to users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "body": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "enum": ["emergency_sos", "women_safety", "health_advisory", "weather_warning", "community_update"] },
        "severity": { "type": "string", "enum": ["critical", "high", "normal"] },
        "targetTopic": { "type": "string", "maxLength": 100 },
        "sender": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "body", "type", "severity", "createdAt"]
    }
  },
  "firestore": {
    "/serviceBookings/{bookingId}": {
      "schema": { "$ref": "#/entities/booking" },
      "description": "Collection of all community service booking inquiries."
    },
    "/emergencyAlerts/{alertId}": {
      "schema": { "$ref": "#/entities/emergencyAlert" },
      "description": "Collection of emergency SOS alert dispatches."
    },
    "/aiConsultations/{consultationId}": {
      "schema": { "$ref": "#/entities/aiConsultation" },
      "description": "Collection of AI Doctor and Agri Doctor consultation logs."
    },
    "/fcmTokens/{tokenId}": {
      "schema": { "$ref": "#/entities/fcmToken" },
      "description": "Collection of registered FCM device push tokens."
    },
    "/fcmBroadcasts/{broadcastId}": {
      "schema": { "$ref": "#/entities/fcmBroadcast" },
      "description": "Collection of emergency broadcasts and real-time updates."
    }
  }
}
